9:["$","p",null,{"style":{"color":"var(--muted)","lineHeight":1.7},"children":"The current models are trained on synthetic landmark data. Recognition accuracy improves significantly with real signer data - the CI pipeline is already in place to gate regressions when real datasets are integrated."}]
