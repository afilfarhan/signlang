5:["$","ol",null,{"style":{"color":"var(--muted)","lineHeight":1.8,"paddingLeft":20},"children":[["$","li",null,{"children":"MediaPipe Hands extracts 21 hand landmarks per frame (WebAssembly, on-device)"}],["$","li",null,{"children":"A JS feature normalization function (mirroring the Python training pipeline) prepares the features"}],["$","li",null,{"children":"An ONNX MLP (static signs) or Transformer (dynamic signs) classifies the sign"}],["$","li",null,{"children":"A rule-based layer provides per-finger interpretability and actionable tips"}]]}]
