7:["$","p",null,{"style":{"color":"var(--muted)","lineHeight":1.7},"children":"SignTutor targets WCAG 2.2 AA conformance. All interactive controls have keyboard navigation, visible focus rings, and ARIA labels. Webcam mirroring is on by default. Left-handed mode flips both the demo and recognition."}]
